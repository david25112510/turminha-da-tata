generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CAREGIVER
  GUARDIAN
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role
  active       Boolean   @default(true)
  phone        String?
  cpf          String?
  birthDate    DateTime?
  photoUrl     String?
  notes        String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // MFA (TOTP) — hoje só oferecido/exigido para role ADMIN (ver src/auth.ts). totpSecret fica em
  // texto plano por natureza do algoritmo (precisa ser lido de volta para calcular o código
  // corrente, não dá para só hashear como a senha) — risco aceito e documentado em
  // docs/architecture.md; considerar cifrar em repouso se o modelo de ameaça exigir.
  totpSecret  String?
  totpEnabled Boolean @default(false)

  guardian            Guardian?
  passwordResetTokens PasswordResetToken[]

  attendanceCheckIns               Attendance[]               @relation("AttendanceCheckInBy")
  attendanceCheckOuts              Attendance[]               @relation("AttendanceCheckOutBy")
  mealRecords                      MealRecord[]
  sleepRecordsStarted              SleepRecord[]              @relation("SleepStartedBy")
  sleepRecordsEnded                SleepRecord[]              @relation("SleepEndedBy")
  hygieneRecords                   HygieneRecord[]
  waterRecords                     WaterRecord[]
  activities                       Activity[]
  moodRecords                      MoodRecord[]
  healthLogs                       HealthLog[]
  medicationAdministrations        MedicationAdministration[]
  medicationAuthorizationsReviewed MedicationAuthorization[]  @relation("MedicationAuthorizationReviewedBy")
  incidents                        Incident[]
  photos                           Photo[]
  childNotesAuthored               ChildNote[]                @relation("ChildNoteAuthorUser")
  announcementsCreated             Announcement[]
  paymentsRecorded                 Payment[]
  auditLogs                        AuditLog[]
  contractVersionsCreated          ContractVersion[]
  contractAcceptancesMade          ContractAcceptance[]
  consentVersionsCreated           ConsentVersion[]
  consentAcceptancesMade           ConsentAcceptance[]
  guardianInvitesCreated           GuardianInvite[]           @relation("GuardianInviteCreatedBy")
  signupRequestsReviewed           SignupRequest[]            @relation("SignupRequestReviewedBy")

  @@map("users")
}

enum Sex {
  FEMALE
  MALE
}

enum ChildStatus {
  ACTIVE
  INACTIVE
}

enum Relationship {
  MOTHER
  FATHER
  GRANDMOTHER
  GRANDFATHER
  AUNT
  UNCLE
  SIBLING
  LEGAL_GUARDIAN
  OTHER
}

model Child {
  id               String      @id @default(cuid())
  fullName         String
  preferredName    String?
  photoUrl         String?
  birthDate        DateTime
  cpf              String?
  birthCertificate String?
  sex              Sex
  enrollmentDate   DateTime    @default(now())
  status           ChildStatus @default(ACTIVE)
  // Quando a criança deixou de ser ativa — base para a política de retenção/anonimização de dados
  // (ver docs/lgpd.md). Continua null enquanto ACTIVE; hoje não existe tela que desative uma
  // criança (ver "Dívida técnica" em docs/architecture.md), então este campo é preparação de
  // schema para quando essa tela existir, não uma automação já em funcionamento.
  inactivatedAt    DateTime?
  generalNotes     String?

  // Autorizações de imagem por finalidade — uma autorização geral antiga não vira autorização
  // automática para publicidade (ver migration de introdução destes campos). Gerenciadas só pelo
  // admin (checkboxes na ficha da criança); sem tela própria no Portal dos Pais.
  imageAuthInternal      Boolean @default(false) // registro interno (diário de cuidados)
  imageAuthGuardianShare Boolean @default(false) // compartilhamento com o responsável no portal
  imageAuthInstitutional Boolean @default(false) // comunicação institucional
  imageAuthSocialMedia   Boolean @default(false) // redes sociais
  imageAuthAdvertising   Boolean @default(false) // publicidade

  contractedEntryTime String
  contractedExitTime  String
  contractedDays      String[]
  toleranceMinutes    Int      @default(0)
  monthlyFee          Decimal  @db.Decimal(10, 2)
  overtimeHourRate    Decimal  @db.Decimal(10, 2)
  dueDay              Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guardians              GuardianChild[]
  authorizedPickupPeople AuthorizedPickupPerson[]

  attendances               Attendance[]
  homeDepartures            HomeDeparture[]
  meals                     MealRecord[]
  sleeps                    SleepRecord[]
  hygieneRecords            HygieneRecord[]
  waterRecords              WaterRecord[]
  moods                     MoodRecord[]
  activities                ActivityChild[]
  healthProfile             HealthProfile?
  healthLogs                HealthLog[]
  medicationAuthorizations  MedicationAuthorization[]
  medicationAdministrations MedicationAdministration[]
  incidents                 Incident[]
  photos                    Photo[]
  childNotes                ChildNote[]
  announcementsTargeted     Announcement[]
  notifications             Notification[]
  invoices                  MonthlyInvoice[]
  contractAcceptances       ContractAcceptance[]
  guardianInvites           GuardianInvite[]

  @@map("children")
}

model Guardian {
  id        String    @id @default(cuid())
  userId    String?   @unique
  name      String
  cpf       String
  birthDate DateTime?
  phone     String
  whatsapp  String?
  email     String?
  address   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user             User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  children         GuardianChild[]
  authorizedPeople AuthorizedPickupPerson[]

  homeDepartures           HomeDeparture[]
  medicationAuthorizations MedicationAuthorization[]
  incidentsNotified        Incident[]
  announcementsTargeted    Announcement[]
  notifications            Notification[]
  pushSubscriptions        PushSubscription[]
  attendanceCheckIns       Attendance[]              @relation("AttendanceCheckInGuardian")
  attendanceCheckOuts      Attendance[]              @relation("AttendanceCheckOutGuardian")
  contractAcceptances      ContractAcceptance[]
  consentAcceptances       ConsentAcceptance[]
  childNotesAuthored       ChildNote[]               @relation("ChildNoteAuthorGuardian")

  @@map("guardians")
}

model GuardianChild {
  id         String @id @default(cuid())
  guardianId String
  childId    String

  relationship           Relationship
  isFinancialResponsible Boolean      @default(false)
  isPrimary              Boolean      @default(false)

  receiveNotifications  Boolean @default(true)
  viewRoutine           Boolean @default(true)
  viewPhotos            Boolean @default(true)
  authorizeMedication   Boolean @default(false)
  authorizePickup       Boolean @default(false)
  viewFinancial         Boolean @default(false)
  receiveCommunications Boolean @default(true)

  createdAt DateTime @default(now())

  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  child    Child    @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([guardianId, childId])
  @@index([childId])
  @@map("guardian_children")
}

enum AuthorizedPersonStatus {
  ACTIVE
  INACTIVE
}

model AuthorizedPickupPerson {
  id           String                 @id @default(cuid())
  childId      String
  name         String
  cpf          String?
  phone        String
  relationship Relationship
  photoUrl     String?
  notes        String?
  status       AuthorizedPersonStatus @default(ACTIVE)

  authorizedByGuardianId String

  createdAt DateTime @default(now())

  child        Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  // Cascade (não SetNull): esta é uma pessoa cadastrada PELO guardian, não um dado independente da
  // criança — se o responsável que a cadastrou for excluído, ela deixa de fazer sentido sozinha.
  // Attendance, que referencia esta pessoa como quem buscou a criança num dia específico, usa SetNull
  // (não Cascade) para nunca perder esse registro por causa desta cascata.
  authorizedBy Guardian @relation(fields: [authorizedByGuardianId], references: [id], onDelete: Cascade)

  attendanceCheckIns  Attendance[] @relation("AttendanceCheckInAuthorizedPerson")
  attendanceCheckOuts Attendance[] @relation("AttendanceCheckOutAuthorizedPerson")

  @@index([childId])
  @@map("authorized_pickup_people")
}

// ---------------------------------------------------------------------------
// Fase 4 — Operação
// ---------------------------------------------------------------------------

model Attendance {
  id      String   @id @default(cuid())
  childId String
  date    DateTime @db.Date

  checkInTime                     DateTime?
  checkInPersonName               String?
  checkInPersonRelation           String?
  checkInReceivedById             String?
  checkInGuardianId               String?
  checkInAuthorizedPickupPersonId String?

  checkOutTime                     DateTime?
  checkOutPersonName               String?
  checkOutPersonRelation           String?
  checkOutReceivedById             String?
  checkOutGuardianId               String?
  checkOutAuthorizedPickupPersonId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  child              Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  // SetNull em toda esta seção: Attendance é dado da CRIANÇA (chegada/saída daquele dia) — não pode
  // sumir nem travar a exclusão de quem participou dela. O snapshot de nome/parentesco já gravado em
  // checkInPersonName/checkInPersonRelation preserva a informação legível mesmo que a referência suma.
  checkInReceivedBy  User? @relation("AttendanceCheckInBy", fields: [checkInReceivedById], references: [id], onDelete: SetNull)
  checkOutReceivedBy User? @relation("AttendanceCheckOutBy", fields: [checkOutReceivedById], references: [id], onDelete: SetNull)

  checkInGuardian                Guardian?               @relation("AttendanceCheckInGuardian", fields: [checkInGuardianId], references: [id], onDelete: SetNull)
  checkInAuthorizedPickupPerson  AuthorizedPickupPerson? @relation("AttendanceCheckInAuthorizedPerson", fields: [checkInAuthorizedPickupPersonId], references: [id], onDelete: SetNull)
  checkOutGuardian               Guardian?               @relation("AttendanceCheckOutGuardian", fields: [checkOutGuardianId], references: [id], onDelete: SetNull)
  checkOutAuthorizedPickupPerson AuthorizedPickupPerson? @relation("AttendanceCheckOutAuthorizedPerson", fields: [checkOutAuthorizedPickupPersonId], references: [id], onDelete: SetNull)

  @@unique([childId, date])
  @@index([date])
  @@map("attendances")
}

model HomeDeparture {
  id         String   @id @default(cuid())
  childId    String
  guardianId String
  time       DateTime @default(now())

  child    Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@index([guardianId])
  @@map("home_departures")
}

enum MealType {
  BREAKFAST
  SNACK
  LUNCH
  AFTERNOON_SNACK
  DINNER
  OTHER
}

enum ConsumptionLevel {
  ALL
  WELL
  LITTLE
  NONE
}

model MealRecord {
  id           String           @id @default(cuid())
  childId      String
  time         DateTime         @default(now())
  mealType     MealType
  consumption  ConsumptionLevel
  notes        String?
  recordedById String?

  child      Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  recordedBy User? @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([childId, time])
  @@index([time])
  @@map("meal_records")
}

model SleepRecord {
  id        String    @id @default(cuid())
  childId   String
  startTime DateTime  @default(now())
  endTime   DateTime?

  startedById String?
  endedById   String?

  child     Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  startedBy User? @relation("SleepStartedBy", fields: [startedById], references: [id], onDelete: SetNull)
  endedBy   User? @relation("SleepEndedBy", fields: [endedById], references: [id], onDelete: SetNull)

  @@index([childId, startTime])
  @@index([startTime])
  @@map("sleep_records")
}

enum HygieneType {
  BATHROOM
  DIAPER_CHANGE
  PERSONAL_HYGIENE
  HANDWASHING
  TOOTHBRUSHING
  OTHER
}

/// Granularidade específica da troca de fralda — só relevante quando HygieneRecord.type == DIAPER_CHANGE;
/// para os demais tipos de higiene fica null. Campo separado (não substitui HygieneType) para não obrigar
/// o botão genérico "Higiene" a lidar com essa pergunta extra.
enum DiaperType {
  WET
  DIRTY
  BOTH
  DRY
  OTHER
}

model HygieneRecord {
  id           String      @id @default(cuid())
  childId      String
  time         DateTime    @default(now())
  type         HygieneType
  diaperType   DiaperType?
  notes        String?
  recordedById String?

  child      Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  recordedBy User? @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([childId, time])
  @@index([time])
  @@map("hygiene_records")
}

enum WaterAmount {
  LITTLE
  MEDIUM
  A_LOT
}

model WaterRecord {
  id           String      @id @default(cuid())
  childId      String
  time         DateTime    @default(now())
  amount       WaterAmount
  notes        String?
  recordedById String?

  child      Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  recordedBy User? @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([childId, time])
  @@index([time])
  @@map("water_records")
}

enum ActivityCategory {
  PAINTING
  DRAWING
  MUSIC
  STORY
  GAMES
  RECREATION
  OUTDOOR
  MOTOR_COORDINATION
  PEDAGOGICAL
  FREE_PLAY
  OTHER
}

model Activity {
  id           String           @id @default(cuid())
  date         DateTime         @db.Date
  time         DateTime         @default(now())
  category     ActivityCategory
  description  String?
  notes        String?
  recordedById String?

  recordedBy User?           @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  children   ActivityChild[]
  photos     Photo[]

  @@index([date])
  @@index([time])
  @@map("activities")
}

model ActivityChild {
  activityId String
  childId    String

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  child    Child    @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@id([activityId, childId])
  @@index([childId])
  @@map("activity_children")
}

enum Mood {
  VERY_HAPPY
  HAPPY
  GOOD
  NORMAL
  TIRED
  SAD
  CRIED
  IRRITATED
  OTHER
}

model MoodRecord {
  id           String   @id @default(cuid())
  childId      String
  time         DateTime @default(now())
  mood         Mood
  notes        String?
  recordedById String?

  child      Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  recordedBy User? @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([childId, time])
  @@index([time])
  @@map("mood_records")
}

model HealthProfile {
  id                    String   @id @default(cuid())
  childId               String   @unique
  allergies             String?
  dietaryRestrictions   String?
  authorizedMedications String?
  importantInfo         String?
  healthInsurance       String?
  doctorName            String?
  emergencyPhone        String?
  notes                 String?
  updatedAt             DateTime @updatedAt

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@map("health_profiles")
}

model HealthLog {
  id           String   @id @default(cuid())
  childId      String
  time         DateTime @default(now())
  temperature  Decimal? @db.Decimal(4, 1)
  symptoms     String?
  notes        String?
  recordedById String?

  child      Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  recordedBy User? @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([childId, time])
  @@index([time])
  @@map("health_logs")
}

/// Workflow de aprovação da autorização — distinto do booleano `active` (que continua significando
/// "vigente/pode ser administrada agora", já usado por src/lib/dashboard.ts e pela validação de
/// addMedicationAdministrationAction). PENDING nasce com active=false; só ACTIVE tem active=true.
enum MedicationAuthorizationStatus {
  PENDING
  ACTIVE
  PAUSED
  ENDED
  REFUSED
}

model MedicationAuthorization {
  id                     String    @id @default(cuid())
  childId                String
  medication             String
  dosage                 String
  scheduleTime           String?
  instructions           String?
  authorizedByGuardianId String?
  documentUrl            String?
  validFrom              DateTime
  validUntil             DateTime?
  active                 Boolean   @default(true)

  status           MedicationAuthorizationStatus @default(PENDING)
  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewNotes      String?

  createdAt DateTime @default(now())

  // SetNull em ambas: uma autorização de medicamento — e o histórico real de administração que ela
  // acumula — é dado da CRIANÇA, não do responsável que solicitou nem do admin que revisou.
  child           Child                      @relation(fields: [childId], references: [id], onDelete: Cascade)
  authorizedBy    Guardian?                  @relation(fields: [authorizedByGuardianId], references: [id], onDelete: SetNull)
  reviewedBy      User?                      @relation("MedicationAuthorizationReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  administrations MedicationAdministration[]

  @@index([childId, active])
  @@index([childId, status])
  @@map("medication_authorizations")
}

model MedicationAdministration {
  id               String   @id @default(cuid())
  authorizationId  String
  childId          String
  time             DateTime @default(now())
  administeredById String?
  notes            String?

  authorization  MedicationAuthorization @relation(fields: [authorizationId], references: [id], onDelete: Cascade)
  child          Child                   @relation(fields: [childId], references: [id], onDelete: Cascade)
  administeredBy User?                   @relation(fields: [administeredById], references: [id], onDelete: SetNull)

  @@index([childId, time])
  @@index([time])
  @@map("medication_administrations")
}

enum ChildNoteAuthorRole {
  CAREGIVER
  GUARDIAN
}

enum ChildNoteStatus {
  NEW
  READ
  ANSWERED
  ARCHIVED
}

/// Observação em texto livre associada a uma criança — cobre dois casos com o mesmo formato:
/// (1) nota solta da cuidadora/admin sobre o dia (authorRole=CAREGIVER, aparece na timeline,
/// `status` não é usado nesse caso); (2) observação que a família envia para a escola
/// (authorRole=GUARDIAN, com o ciclo de vida NEW→READ→ANSWERED→ARCHIVED lido pela creche).
model ChildNote {
  id               String              @id @default(cuid())
  childId          String
  authorRole       ChildNoteAuthorRole
  authorUserId     String?
  authorGuardianId String?
  text             String
  status           ChildNoteStatus     @default(NEW)
  time             DateTime            @default(now())

  createdAt DateTime @default(now())

  child          Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  authorUser     User?     @relation("ChildNoteAuthorUser", fields: [authorUserId], references: [id], onDelete: SetNull)
  authorGuardian Guardian? @relation("ChildNoteAuthorGuardian", fields: [authorGuardianId], references: [id], onDelete: SetNull)

  @@index([childId, time])
  @@index([childId, authorRole, status])
  @@map("child_notes")
}

enum IncidentType {
  FALL
  ACCIDENT
  CRYING
  ILLNESS
  FEVER
  BEHAVIOR_CHANGE
  INJURY
  OTHER
}

model Incident {
  id           String       @id @default(cuid())
  childId      String
  time         DateTime     @default(now())
  type         IncidentType
  description  String
  actionsTaken String?
  recordedById String?

  guardianNotifiedId String?
  notifiedAt         DateTime?

  child            Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  recordedBy       User?     @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  guardianNotified Guardian? @relation(fields: [guardianNotifiedId], references: [id], onDelete: SetNull)
  photos           Photo[]

  @@index([childId, time])
  @@index([time])
  @@index([guardianNotifiedId])
  @@map("incidents")
}

model Photo {
  id           String   @id @default(cuid())
  childId      String
  activityId   String?
  incidentId   String?
  url          String
  caption      String?
  takenAt      DateTime @default(now())
  uploadedById String?

  child      Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  activity   Activity? @relation(fields: [activityId], references: [id])
  incident   Incident? @relation(fields: [incidentId], references: [id])
  uploadedBy User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([childId, takenAt])
  @@index([takenAt])
  @@map("photos")
}

// ---------------------------------------------------------------------------
// Fase 5 — Portal dos pais
// ---------------------------------------------------------------------------

enum AnnouncementType {
  ANNOUNCEMENT
  NOTICE
  REMINDER
  EVENT
  INFO
}

enum AnnouncementTarget {
  ALL
  GUARDIAN
  CHILD
}

model Announcement {
  id        String             @id @default(cuid())
  title     String
  body      String
  type      AnnouncementType   @default(ANNOUNCEMENT)
  target    AnnouncementTarget @default(ALL)
  eventDate DateTime?

  targetGuardianId String?
  targetChildId    String?

  createdById String?
  createdAt   DateTime @default(now())

  createdBy      User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  targetGuardian Guardian? @relation(fields: [targetGuardianId], references: [id], onDelete: SetNull)
  targetChild    Child?    @relation(fields: [targetChildId], references: [id], onDelete: SetNull)

  @@index([target])
  @@index([type, eventDate])
  @@map("announcements")
}

enum NotificationType {
  ARRIVAL
  DEPARTURE
  MEAL
  SLEEP
  PHOTO
  INCIDENT
  ANNOUNCEMENT
  FINANCIAL
  MEDICATION
  OBSERVATION
}

model Notification {
  id         String           @id @default(cuid())
  guardianId String
  childId    String?
  type       NotificationType
  title      String
  body       String
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now())

  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  child    Child?   @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([guardianId, read])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Fase 6 — Financeiro
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
  PARTIALLY_PAID
}

model MonthlyInvoice {
  id             String        @id @default(cuid())
  childId        String
  referenceMonth Int
  referenceYear  Int
  monthlyFee     Decimal       @db.Decimal(10, 2)
  overtimeTotal  Decimal       @default(0) @db.Decimal(10, 2)
  discounts      Decimal       @default(0) @db.Decimal(10, 2)
  otherCharges   Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal       @db.Decimal(10, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(10, 2)
  dueDate        DateTime      @db.Date
  status         InvoiceStatus @default(PENDING)
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  child      Child         @relation(fields: [childId], references: [id], onDelete: Cascade)
  payments   Payment[]
  items      InvoiceItem[]
  pixCharges PixCharge[]

  @@unique([childId, referenceMonth, referenceYear])
  @@index([status])
  @@index([createdAt])
  @@map("monthly_invoices")
}

/// Cobrança Pix gerada via Mercado Pago para uma fatura — ver src/lib/mercadopago.ts. Uma fatura
/// pode acumular várias (a anterior expira sem ser paga, o responsável gera outra); a confirmação
/// chega pelo webhook (src/app/api/webhooks/mercadopago/route.ts), nunca por polling do cliente.
model PixCharge {
  id                String    @id @default(cuid())
  invoiceId         String
  externalPaymentId String    @unique
  initiatedByUserId String
  status            String    @default("pending")
  amount            Decimal   @db.Decimal(10, 2)
  qrCode            String    @db.Text
  qrCodeText        String    @db.Text
  expiresAt         DateTime
  paidAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice MonthlyInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("pix_charges")
}

enum InvoiceItemType {
  MONTHLY_FEE
  OVERTIME
  DISCOUNT
  CREDIT
  DEBIT
  ADJUSTMENT
  OTHER
}

/// Item detalhado de uma cobrança — a fotografia do que compôs o total no momento do fechamento (ou de um
/// ajuste posterior). Itens já criados nunca são editados; correções viram um novo item (CREDIT/DEBIT/ADJUSTMENT).
model InvoiceItem {
  id          String          @id @default(cuid())
  invoiceId   String
  type        InvoiceItemType
  description String
  quantity    Decimal?        @db.Decimal(10, 2)
  unitPrice   Decimal?        @db.Decimal(10, 2)
  amount      Decimal         @db.Decimal(10, 2)
  metadata    Json?
  createdAt   DateTime        @default(now())

  invoice MonthlyInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  amount    Decimal  @db.Decimal(10, 2)
  paidAt    DateTime @default(now())
  method    String?
  notes     String?

  recordedById String?

  invoice    MonthlyInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy User?          @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([paidAt])
  @@index([invoiceId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Fase 8 — Notificações push
// ---------------------------------------------------------------------------

model PushSubscription {
  id         String   @id @default(cuid())
  guardianId String
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())

  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@index([guardianId])
  @@map("push_subscriptions")
}

// ---------------------------------------------------------------------------
// Recuperação de senha
// ---------------------------------------------------------------------------

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Auto-cadastro (cuidadora/responsável) com aprovação do admin
// ---------------------------------------------------------------------------

enum GuardianInviteStatus {
  PENDING
  USED
  EXPIRED
  REVOKED
}

/// Convite para um responsável se auto-cadastrar vinculado a UMA criança específica — gerado pelo
/// admin na ficha da criança e repassado pessoalmente à família (não é um link público). Só o hash
/// do código fica no banco (mesmo padrão de PasswordResetToken); o código bruto só existe na tela
/// no momento em que é gerado, nunca mais recuperável depois.
model GuardianInvite {
  id              String               @id @default(cuid())
  childId         String
  codeHash        String               @unique
  status          GuardianInviteStatus @default(PENDING)
  expiresAt       DateTime
  createdByUserId String?
  usedAt          DateTime?

  createdAt DateTime @default(now())

  child          Child           @relation(fields: [childId], references: [id], onDelete: Cascade)
  createdBy      User?           @relation("GuardianInviteCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  signupRequests SignupRequest[]

  @@index([childId])
  @@map("guardian_invites")
}

enum SignupRequestRole {
  CAREGIVER
  GUARDIAN
}

enum SignupRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Solicitação de conta enviada pela tela pública /cadastro — nunca cria User diretamente. Só vira
/// conta de verdade (User, e para GUARDIAN também Guardian+GuardianChild) quando o admin aprova em
/// /admin/solicitacoes. A senha já vem hasheada aqui (nunca em texto plano, mesmo antes da aprovação).
model SignupRequest {
  id           String            @id @default(cuid())
  role         SignupRequestRole
  name         String
  email        String
  passwordHash String
  phone        String?
  cpf          String?

  // Só preenchidos quando role == GUARDIAN
  inviteId     String?
  relationship Relationship?

  status           SignupRequestStatus @default(PENDING)
  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewNotes      String?

  createdAt DateTime @default(now())

  invite     GuardianInvite? @relation(fields: [inviteId], references: [id], onDelete: SetNull)
  reviewedBy User?           @relation("SignupRequestReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("signup_requests")
}

// ---------------------------------------------------------------------------
// Notificações administrativas
// ---------------------------------------------------------------------------

enum AdminNotificationType {
  INCIDENT
  MEDICATION
  INVOICE_OVERDUE
  CAREGIVER_CREATED
  OBSERVATION
  SIGNUP_REQUEST
}

model AdminNotification {
  id        String                @id @default(cuid())
  type      AdminNotificationType
  title     String
  body      String
  entity    String?
  entityId  String?
  read      Boolean               @default(false)
  createdAt DateTime              @default(now())

  @@index([read, createdAt])
  @@map("admin_notifications")
}

// ---------------------------------------------------------------------------
// Auditoria administrativa
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entity      String
  entityId    String
  oldData     Json?
  newData     Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  // SetNull, nunca Cascade nem Restrict: a auditoria não pode sumir nem travar a exclusão de quem a
  // gerou — é exatamente o registro que precisa sobreviver ao autor para provar o que aconteceu.
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Contrato digital
// ---------------------------------------------------------------------------

enum ContractVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ContractVersion {
  id          String                @id @default(cuid())
  version     String
  content     String
  status      ContractVersionStatus @default(PUBLISHED)
  createdById String?
  createdAt   DateTime              @default(now())
  publishedAt DateTime?

  // SetNull (não Restrict): a versão do contrato sobrevive mesmo que o admin que a criou seja removido —
  // não é razão para bloquear a exclusão de um usuário. Quem criou fica registrado de forma permanente no
  // AuditLog (CONTRATO_CRIADO/CONTRATO_PUBLICADO), que não depende deste campo.
  createdBy   User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  acceptances ContractAcceptance[]

  @@map("contract_versions")
}

enum ContractAcceptanceStatus {
  PENDING
  ACCEPTED
  CANCELLED
}

model ContractAcceptance {
  id               String                   @id @default(cuid())
  childId          String
  guardianId       String
  versionId        String
  status           ContractAcceptanceStatus @default(PENDING)
  acceptedAt       DateTime?
  acceptedByUserId String?
  ip               String?
  userAgent        String?
  signatureUrl     String?
  signedAt         DateTime?
  documentHash     String?
  createdAt        DateTime                 @default(now())

  child          Child           @relation(fields: [childId], references: [id], onDelete: Cascade)
  guardian       Guardian        @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  version        ContractVersion @relation(fields: [versionId], references: [id])
  acceptedByUser User?           @relation(fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@unique([childId, guardianId, versionId])
  @@index([guardianId, status])
  @@index([childId])
  @@map("contract_acceptances")
}

// ---------------------------------------------------------------------------
// Consentimento LGPD (tratamento de dados pessoais — distinto da autorização de
// imagem de Child.imageAuthX, e distinto do contrato de prestação de serviços acima)
// ---------------------------------------------------------------------------

enum ConsentVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ConsentVersion {
  id          String               @id @default(cuid())
  version     String
  content     String
  status      ConsentVersionStatus @default(PUBLISHED)
  createdById String?
  createdAt   DateTime             @default(now())
  publishedAt DateTime?

  createdBy   User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  acceptances ConsentAcceptance[]

  @@map("consent_versions")
}

enum ConsentAcceptanceStatus {
  PENDING
  ACCEPTED
}

/// Por guardian, não por criança: o consentimento é sobre o tratamento dos dados pessoais do
/// próprio responsável (e, por extensão, os que ele fornece sobre a criança) — não faz sentido
/// duplicar por filho quando a mesma pessoa tem mais de um vinculado.
model ConsentAcceptance {
  id               String                  @id @default(cuid())
  guardianId       String
  versionId        String
  status           ConsentAcceptanceStatus @default(PENDING)
  acceptedAt       DateTime?
  acceptedByUserId String?
  ip               String?
  userAgent        String?
  signatureUrl     String?
  signedAt         DateTime?
  documentHash     String?
  createdAt        DateTime                @default(now())

  guardian       Guardian       @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  version        ConsentVersion @relation(fields: [versionId], references: [id])
  acceptedByUser User?          @relation(fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@unique([guardianId, versionId])
  @@index([guardianId, status])
  @@map("consent_acceptances")
}
