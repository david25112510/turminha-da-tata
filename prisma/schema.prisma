generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CAREGIVER
  GUARDIAN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  guardian Guardian?

  attendanceCheckIns      Attendance[]              @relation("AttendanceCheckInBy")
  attendanceCheckOuts     Attendance[]              @relation("AttendanceCheckOutBy")
  mealRecords             MealRecord[]
  sleepRecordsStarted     SleepRecord[]             @relation("SleepStartedBy")
  sleepRecordsEnded       SleepRecord[]             @relation("SleepEndedBy")
  hygieneRecords          HygieneRecord[]
  activities              Activity[]
  moodRecords             MoodRecord[]
  healthLogs              HealthLog[]
  medicationAdministrations MedicationAdministration[]
  incidents               Incident[]
  photos                  Photo[]
  announcementsCreated    Announcement[]
  paymentsRecorded        Payment[]
  auditLogs               AuditLog[]

  @@map("users")
}

enum Sex {
  FEMALE
  MALE
}

enum ChildStatus {
  ACTIVE
  INACTIVE
}

enum Relationship {
  MOTHER
  FATHER
  GRANDMOTHER
  GRANDFATHER
  AUNT
  UNCLE
  SIBLING
  LEGAL_GUARDIAN
  OTHER
}

model Child {
  id               String      @id @default(cuid())
  fullName         String
  preferredName    String?
  photoUrl         String?
  birthDate        DateTime
  cpf              String?
  birthCertificate String?
  sex              Sex
  enrollmentDate   DateTime    @default(now())
  status           ChildStatus @default(ACTIVE)
  generalNotes     String?

  imageAuthorized Boolean @default(false)

  contractedEntryTime String
  contractedExitTime  String
  contractedDays      String[]
  toleranceMinutes    Int      @default(0)
  monthlyFee          Decimal  @db.Decimal(10, 2)
  overtimeHourRate    Decimal  @db.Decimal(10, 2)
  dueDay              Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guardians               GuardianChild[]
  authorizedPickupPeople  AuthorizedPickupPerson[]

  attendances              Attendance[]
  homeDepartures           HomeDeparture[]
  meals                    MealRecord[]
  sleeps                   SleepRecord[]
  hygieneRecords           HygieneRecord[]
  moods                    MoodRecord[]
  activities               ActivityChild[]
  healthProfile            HealthProfile?
  healthLogs               HealthLog[]
  medicationAuthorizations MedicationAuthorization[]
  medicationAdministrations MedicationAdministration[]
  incidents                Incident[]
  photos                   Photo[]
  announcementsTargeted    Announcement[]
  notifications            Notification[]
  invoices                 MonthlyInvoice[]

  @@map("children")
}

model Guardian {
  id        String   @id @default(cuid())
  userId    String?  @unique
  name      String
  cpf       String
  birthDate DateTime?
  phone     String
  whatsapp  String?
  email     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?           @relation(fields: [userId], references: [id])
  children GuardianChild[]
  authorizedPeople AuthorizedPickupPerson[]

  homeDepartures           HomeDeparture[]
  medicationAuthorizations MedicationAuthorization[]
  incidentsNotified        Incident[]
  announcementsTargeted    Announcement[]
  notifications            Notification[]
  pushSubscriptions        PushSubscription[]
  attendanceCheckIns       Attendance[] @relation("AttendanceCheckInGuardian")
  attendanceCheckOuts      Attendance[] @relation("AttendanceCheckOutGuardian")

  @@map("guardians")
}

model GuardianChild {
  id        String       @id @default(cuid())
  guardianId String
  childId    String

  relationship            Relationship
  isFinancialResponsible  Boolean      @default(false)
  isPrimary               Boolean      @default(false)

  receiveNotifications  Boolean @default(true)
  viewRoutine           Boolean @default(true)
  viewPhotos            Boolean @default(true)
  authorizeMedication   Boolean @default(false)
  authorizePickup       Boolean @default(false)
  viewFinancial         Boolean @default(false)
  receiveCommunications Boolean @default(true)

  createdAt DateTime @default(now())

  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  child    Child    @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([guardianId, childId])
  @@index([childId])
  @@map("guardian_children")
}

enum AuthorizedPersonStatus {
  ACTIVE
  INACTIVE
}

model AuthorizedPickupPerson {
  id           String                  @id @default(cuid())
  childId      String
  name         String
  cpf          String?
  phone        String
  relationship Relationship
  photoUrl     String?
  notes        String?
  status       AuthorizedPersonStatus  @default(ACTIVE)

  authorizedByGuardianId String

  createdAt DateTime @default(now())

  child           Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  authorizedBy    Guardian @relation(fields: [authorizedByGuardianId], references: [id])

  attendanceCheckIns  Attendance[] @relation("AttendanceCheckInAuthorizedPerson")
  attendanceCheckOuts Attendance[] @relation("AttendanceCheckOutAuthorizedPerson")

  @@map("authorized_pickup_people")
}

// ---------------------------------------------------------------------------
// Fase 4 — Operação
// ---------------------------------------------------------------------------

model Attendance {
  id      String   @id @default(cuid())
  childId String
  date    DateTime @db.Date

  checkInTime             DateTime?
  checkInPersonName       String?
  checkInPersonRelation   String?
  checkInReceivedById     String?
  checkInGuardianId               String?
  checkInAuthorizedPickupPersonId String?

  checkOutTime            DateTime?
  checkOutPersonName      String?
  checkOutPersonRelation  String?
  checkOutReceivedById    String?
  checkOutGuardianId               String?
  checkOutAuthorizedPickupPersonId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  child            Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  checkInReceivedBy  User? @relation("AttendanceCheckInBy", fields: [checkInReceivedById], references: [id])
  checkOutReceivedBy User? @relation("AttendanceCheckOutBy", fields: [checkOutReceivedById], references: [id])

  checkInGuardian               Guardian?               @relation("AttendanceCheckInGuardian", fields: [checkInGuardianId], references: [id])
  checkInAuthorizedPickupPerson AuthorizedPickupPerson? @relation("AttendanceCheckInAuthorizedPerson", fields: [checkInAuthorizedPickupPersonId], references: [id])
  checkOutGuardian               Guardian?               @relation("AttendanceCheckOutGuardian", fields: [checkOutGuardianId], references: [id])
  checkOutAuthorizedPickupPerson AuthorizedPickupPerson? @relation("AttendanceCheckOutAuthorizedPerson", fields: [checkOutAuthorizedPickupPersonId], references: [id])

  @@unique([childId, date])
  @@index([date])
  @@map("attendances")
}

model HomeDeparture {
  id        String   @id @default(cuid())
  childId   String
  guardianId String
  time      DateTime @default(now())

  child    Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id])

  @@map("home_departures")
}

enum MealType {
  BREAKFAST
  SNACK
  LUNCH
  AFTERNOON_SNACK
  DINNER
  OTHER
}

enum ConsumptionLevel {
  ALL
  WELL
  LITTLE
  NONE
}

model MealRecord {
  id         String           @id @default(cuid())
  childId    String
  time       DateTime         @default(now())
  mealType   MealType
  consumption ConsumptionLevel
  notes      String?
  recordedById String

  child      Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  recordedBy User  @relation(fields: [recordedById], references: [id])

  @@index([childId, time])
  @@index([time])
  @@map("meal_records")
}

model SleepRecord {
  id        String    @id @default(cuid())
  childId   String
  startTime DateTime  @default(now())
  endTime   DateTime?

  startedById String
  endedById   String?

  child     Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  startedBy User  @relation("SleepStartedBy", fields: [startedById], references: [id])
  endedBy   User? @relation("SleepEndedBy", fields: [endedById], references: [id])

  @@index([childId, startTime])
  @@index([startTime])
  @@map("sleep_records")
}

enum HygieneType {
  BATHROOM
  DIAPER_CHANGE
  PERSONAL_HYGIENE
  HANDWASHING
  TOOTHBRUSHING
  OTHER
}

model HygieneRecord {
  id           String      @id @default(cuid())
  childId      String
  time         DateTime    @default(now())
  type         HygieneType
  notes        String?
  recordedById String

  child      Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  recordedBy User  @relation(fields: [recordedById], references: [id])

  @@index([childId, time])
  @@index([time])
  @@map("hygiene_records")
}

enum ActivityCategory {
  PAINTING
  DRAWING
  MUSIC
  STORY
  GAMES
  RECREATION
  OUTDOOR
  MOTOR_COORDINATION
  PEDAGOGICAL
  FREE_PLAY
  OTHER
}

model Activity {
  id           String           @id @default(cuid())
  date         DateTime         @db.Date
  time         DateTime         @default(now())
  category     ActivityCategory
  description  String?
  notes        String?
  recordedById String

  recordedBy User            @relation(fields: [recordedById], references: [id])
  children   ActivityChild[]
  photos     Photo[]

  @@index([date])
  @@index([time])
  @@map("activities")
}

model ActivityChild {
  activityId String
  childId    String

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  child    Child    @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@id([activityId, childId])
  @@index([childId])
  @@map("activity_children")
}

enum Mood {
  VERY_HAPPY
  HAPPY
  GOOD
  NORMAL
  TIRED
  SAD
  CRIED
  IRRITATED
  OTHER
}

model MoodRecord {
  id           String   @id @default(cuid())
  childId      String
  time         DateTime @default(now())
  mood         Mood
  notes        String?
  recordedById String

  child      Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  recordedBy User  @relation(fields: [recordedById], references: [id])

  @@index([childId, time])
  @@index([time])
  @@map("mood_records")
}

model HealthProfile {
  id                    String   @id @default(cuid())
  childId               String   @unique
  allergies             String?
  dietaryRestrictions   String?
  authorizedMedications String?
  importantInfo         String?
  healthInsurance       String?
  doctorName            String?
  emergencyPhone        String?
  notes                 String?
  updatedAt             DateTime @updatedAt

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@map("health_profiles")
}

model HealthLog {
  id           String   @id @default(cuid())
  childId      String
  time         DateTime @default(now())
  temperature  Decimal? @db.Decimal(4, 1)
  symptoms     String?
  notes        String?
  recordedById String

  child      Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  recordedBy User  @relation(fields: [recordedById], references: [id])

  @@index([childId, time])
  @@index([time])
  @@map("health_logs")
}

model MedicationAuthorization {
  id                     String    @id @default(cuid())
  childId                String
  medication             String
  dosage                 String
  scheduleTime           String?
  instructions           String?
  authorizedByGuardianId String
  documentUrl            String?
  validFrom              DateTime
  validUntil             DateTime?
  active                 Boolean   @default(true)

  createdAt DateTime @default(now())

  child           Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  authorizedBy    Guardian @relation(fields: [authorizedByGuardianId], references: [id])
  administrations MedicationAdministration[]

  @@index([childId, active])
  @@map("medication_authorizations")
}

model MedicationAdministration {
  id             String   @id @default(cuid())
  authorizationId String
  childId        String
  time           DateTime @default(now())
  administeredById String
  notes          String?

  authorization  MedicationAuthorization @relation(fields: [authorizationId], references: [id], onDelete: Cascade)
  child          Child                   @relation(fields: [childId], references: [id], onDelete: Cascade)
  administeredBy User                    @relation(fields: [administeredById], references: [id])

  @@index([childId, time])
  @@index([time])
  @@map("medication_administrations")
}

enum IncidentType {
  FALL
  ACCIDENT
  CRYING
  ILLNESS
  FEVER
  BEHAVIOR_CHANGE
  INJURY
  OTHER
}

model Incident {
  id           String       @id @default(cuid())
  childId      String
  time         DateTime     @default(now())
  type         IncidentType
  description  String
  actionsTaken String?
  recordedById String

  guardianNotifiedId String?
  notifiedAt         DateTime?

  child             Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  recordedBy        User      @relation(fields: [recordedById], references: [id])
  guardianNotified  Guardian? @relation(fields: [guardianNotifiedId], references: [id])
  photos            Photo[]

  @@index([childId, time])
  @@index([time])
  @@index([guardianNotifiedId])
  @@map("incidents")
}

model Photo {
  id           String   @id @default(cuid())
  childId      String
  activityId   String?
  incidentId   String?
  url          String
  caption      String?
  takenAt      DateTime @default(now())
  uploadedById String

  child      Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  activity   Activity? @relation(fields: [activityId], references: [id])
  incident   Incident? @relation(fields: [incidentId], references: [id])
  uploadedBy User      @relation(fields: [uploadedById], references: [id])

  @@index([childId, takenAt])
  @@index([takenAt])
  @@map("photos")
}

// ---------------------------------------------------------------------------
// Fase 5 — Portal dos pais
// ---------------------------------------------------------------------------

enum AnnouncementType {
  ANNOUNCEMENT
  NOTICE
  REMINDER
  EVENT
  INFO
}

enum AnnouncementTarget {
  ALL
  GUARDIAN
  CHILD
}

model Announcement {
  id        String             @id @default(cuid())
  title     String
  body      String
  type      AnnouncementType   @default(ANNOUNCEMENT)
  target    AnnouncementTarget @default(ALL)
  eventDate DateTime?

  targetGuardianId String?
  targetChildId    String?

  createdById String
  createdAt   DateTime @default(now())

  createdBy      User     @relation(fields: [createdById], references: [id])
  targetGuardian Guardian? @relation(fields: [targetGuardianId], references: [id])
  targetChild    Child?    @relation(fields: [targetChildId], references: [id])

  @@index([target])
  @@index([type, eventDate])
  @@map("announcements")
}

enum NotificationType {
  ARRIVAL
  DEPARTURE
  MEAL
  SLEEP
  PHOTO
  INCIDENT
  ANNOUNCEMENT
  FINANCIAL
}

model Notification {
  id         String           @id @default(cuid())
  guardianId String
  childId    String?
  type       NotificationType
  title      String
  body       String
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now())

  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  child    Child?   @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([guardianId, read])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Fase 6 — Financeiro
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
  PARTIALLY_PAID
}

model MonthlyInvoice {
  id              String        @id @default(cuid())
  childId         String
  referenceMonth  Int
  referenceYear   Int
  monthlyFee      Decimal       @db.Decimal(10, 2)
  overtimeTotal   Decimal       @default(0) @db.Decimal(10, 2)
  discounts       Decimal       @default(0) @db.Decimal(10, 2)
  otherCharges    Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal       @db.Decimal(10, 2)
  paidAmount      Decimal       @default(0) @db.Decimal(10, 2)
  dueDate         DateTime      @db.Date
  status          InvoiceStatus @default(PENDING)
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  child    Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@unique([childId, referenceMonth, referenceYear])
  @@index([status])
  @@index([createdAt])
  @@map("monthly_invoices")
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  amount    Decimal  @db.Decimal(10, 2)
  paidAt    DateTime @default(now())
  method    String?
  notes     String?

  recordedById String

  invoice    MonthlyInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy User           @relation(fields: [recordedById], references: [id])

  @@index([paidAt])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Fase 8 — Notificações push
// ---------------------------------------------------------------------------

model PushSubscription {
  id         String   @id @default(cuid())
  guardianId String
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())

  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@index([guardianId])
  @@map("push_subscriptions")
}

// ---------------------------------------------------------------------------
// Auditoria administrativa
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String
  entity      String
  entityId    String
  oldData     Json?
  newData     Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  actor User @relation(fields: [actorUserId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
