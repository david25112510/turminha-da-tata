DATABASE_URL="postgresql://postgres:devpassword@127.0.0.1:5432/turminha_da_tata?schema=public"
AUTH_SECRET="generate-with-node -e-console.log-require-crypto-randomBytes-32-toString-base64"

# Bootstrap da primeira conta ADMIN. Não há senha padrão no código.
# Em produção, o seed falha de modo seguro se ADMIN_EMAIL ou ADMIN_INITIAL_PASSWORD não estiverem
# definidos. A senha inicial deve ter pelo menos 15 caracteres e nunca é impressa nos logs.
# Se o usuário já existir, executar o seed novamente NÃO altera senha, MFA, role ou status.
ADMIN_EMAIL=""
ADMIN_INITIAL_PASSWORD=""
ADMIN_NAME="Administradora"

# URL pública do app — usada para montar o link de "esqueci minha senha" enviado por e-mail.
APP_URL="http://localhost:3000"

# Cloudflare Turnstile (Managed). Em produção, as duas chaves são obrigatórias e a validação falha
# de modo seguro quando ausentes. Em desenvolvimento/testes, o app usa as chaves oficiais de teste
# "always pass" da Cloudflare quando estas variáveis não forem definidas.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Opcional: envio de e-mail (recuperação de senha) via API HTTP da Resend (https://resend.com).
# Se RESEND_API_KEY ou EMAIL_FROM não estiverem definidos, o token de recuperação ainda é gerado,
# mas o e-mail não é enviado (fica registrado no log do servidor) — só adequado para desenvolvimento.
RESEND_API_KEY=""
EMAIL_FROM="Turminha da Tata <naoresponda@turminhadatata.com.br>"

# generate with: npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@turminhadatata.com.br"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Opcional: rate limiting do login/recuperação de senha via Upstash Redis (REST, sem SDK).
# Se não definido, cai para um Map em memória do processo — funciona para dev local ou uma única
# instância, mas não sobrevive a restart nem é compartilhado entre múltiplas instâncias. Crie um
# banco em https://console.upstash.com (camada gratuita é suficiente) e copie a URL/token REST.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Opcional: armazenamento de objetos (S3, Cloudflare R2 ou compatível) para fotos.
# Se STORAGE_S3_BUCKET não estiver definido, os novos uploads são salvos em .data/uploads e servidos
# somente pela rota autenticada /api/storage — adequado apenas para desenvolvimento ou hospedagem
# com disco persistente. Em Railway/produção, prefira storage externo persistente e bucket privado.
STORAGE_S3_BUCKET=""
STORAGE_S3_REGION="auto"
STORAGE_S3_ENDPOINT=""
STORAGE_S3_ACCESS_KEY_ID=""
STORAGE_S3_SECRET_ACCESS_KEY=""
# Compatibilidade para extrair chaves de URLs públicas antigas; novos uploads não dependem dela.
STORAGE_S3_PUBLIC_URL=""
# Opcional: "AES256" ou "aws:kms", conforme suporte do provider.
STORAGE_S3_SERVER_SIDE_ENCRYPTION=""

# Opcional: pagamento via Pix (Mercado Pago, API HTTP, sem SDK). Sem MERCADO_PAGO_ACCESS_TOKEN, o
# botão "Pagar com Pix" some do Portal dos Pais — o app funciona normalmente sem esse recurso.
# MERCADO_PAGO_WEBHOOK_SECRET é opcional mas fortemente recomendado em produção: sem ele, o endpoint
# de webhook aceita qualquer notificação sem checar a assinatura (só use isso em dev local).
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_WEBHOOK_SECRET=""
