DATABASE_URL="postgresql://postgres:devpassword@127.0.0.1:5432/turminha_da_tata?schema=public"
AUTH_SECRET="generate-with-node -e-console.log-require-crypto-randomBytes-32-toString-base64"

# URL pública do app — usada para montar o link de "esqueci minha senha" enviado por e-mail.
APP_URL="http://localhost:3000"

# Opcional: envio de e-mail (recuperação de senha) via API HTTP da Resend (https://resend.com).
# Se RESEND_API_KEY ou EMAIL_FROM não estiverem definidos, o token de recuperação ainda é gerado,
# mas o e-mail não é enviado (fica registrado no log do servidor) — só adequado para desenvolvimento.
RESEND_API_KEY=""
EMAIL_FROM="Turminha da Tata <naoresponda@turminhadatata.com.br>"

# generate with: npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@turminhadatata.com.br"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Opcional: armazenamento de objetos (S3, Cloudflare R2 ou compatível) para fotos.
# Se STORAGE_S3_BUCKET não estiver definido, as fotos são salvas em disco local (public/uploads/) — só
# adequado para desenvolvimento ou hospedagem de instância única com disco persistente.
STORAGE_S3_BUCKET=""
STORAGE_S3_REGION="auto"
STORAGE_S3_ENDPOINT=""
STORAGE_S3_ACCESS_KEY_ID=""
STORAGE_S3_SECRET_ACCESS_KEY=""
STORAGE_S3_PUBLIC_URL=""
